# Copy this file to .env and fill in the values
# cp .env.example .env

# PostgreSQL
POSTGRES_PASSWORD=changeme

# Auth Service — Database
DATABASE_URL=postgresql://oppi:changeme@localhost:5432/auth_db

# Auth Service — JWT (minimum 32 characters each, must be different)
JWT_ACCESS_SECRET=change-me-to-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-to-a-different-minimum-32-characters

# AWS / LocalStack
AWS_REGION=eu-north-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_AUTH_TOKEN=

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# Redis
REDIS_URL=redis://localhost:6379
